NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyreader
DB_USER=postgres
DB_PASSWORD=your_postgres_password

SESSION_SECRET=your_session_secret

# Role Authorization
ADMIN_SECRET_KEY=ADMIN2026

# Local Piper text-to-speech configuration.
# Install Piper and download an ONNX voice model locally.
PIPER_EXECUTABLE=C:\Tools\piper\piper.exe
PIPER_MODEL=C:\Tools\piper\voices\en_US-lessac-medium.onnx
PIPER_VOICE_NAME=Local English voice
PIPER_LANGUAGE=en-US

# Local Ollama document AI configuration.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b