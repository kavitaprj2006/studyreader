# Dependencies
node_modules/
backend/node_modules/

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.cert
*service-account*.json
firebase-admin-key*.json
firebase-key*.json

# User Uploaded Documents (Ephemeral local uploads & private bucket)
backend/uploads/*
!backend/uploads/.gitkeep
backend/storage_bucket/**
!backend/storage_bucket/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vercel & Deployment Builds
.vercel
dist/
build/
.cache/

# Database Backups
database/backups/*
!database/backups/.gitkeep
