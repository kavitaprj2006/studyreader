# ============================================================
# StudyReader Cloud Platform — Root Environment Template
# ============================================================

# Runtime Environment
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://studyreader.vercel.app

# ============================================================
# Primary Application Database (Neon PostgreSQL with pgvector)
# ============================================================
# Pooled connection via PgBouncer for application queries and session store
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection to Neon compute for DDL, migrations and administrative tasks
DIRECT_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local fallback (for offline development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyreader
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# ============================================================
# Authentication & Security
# ============================================================
SESSION_SECRET=your_strong_random_session_secret_at_least_32_characters
ADMIN_SECRET_KEY=ADMIN2026
CRON_SECRET=your_secure_cron_secret_for_job_triggers

# ============================================================
# Hosted Google Gemini AI (Tier 1 Primary)
# ============================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Multi-Tier AI Backup Providers (Automatic Failover)
# ============================================================
# Tier 2: Groq LPU (High-speed inference via console.groq.com)
# Primary Groq: openai/gpt-oss-120b | Failover: openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# Tier 3: Cloudflare Workers AI (Global edge inference via dash.cloudflare.com)
# Primary Cloudflare: @cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ============================================================
# Primary File Storage: Supabase Storage (ACTIVE / DEFAULT)
# ============================================================
# Supabase is used strictly for private document object storage.
# Database remains Neon PostgreSQL. Never expose secret keys on the frontend.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
SUPABASE_STORAGE_BUCKET=studyreader

# ============================================================
# Reserved / Future Storage Provider: Cloudflare R2 (INACTIVE)
# ============================================================
# Cloudflare R2 implementation is fully retained for future use.
# To switch to R2 in the future, set STORAGE_PROVIDER=r2 and uncomment:
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=

# ============================================================
# Firebase Admin SDK & Cloud Storage (studyreader-ad48c)
# ============================================================
FIREBASE_PROJECT_ID=studyreader-ad48c
FIREBASE_STORAGE_BUCKET=studyreader-ad48c.firebasestorage.app
# Option A: Service account JSON key file path
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-key.json
# Option B: Direct environment credentials
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@studyreader-ad48c.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
