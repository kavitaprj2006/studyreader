{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/jobs/process-batch?limit=2&timeBudgetMs=8000",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/frontend/pages/login/index.html", "permanent": false },
    { "source": "/login", "destination": "/frontend/pages/login/index.html", "permanent": false },
    { "source": "/signup", "destination": "/frontend/pages/signup/index.html", "permanent": false },
    { "source": "/dashboard", "destination": "/frontend/pages/dashboard/index.html", "permanent": false },
    { "source": "/teacher-dashboard", "destination": "/frontend/pages/teacher-dashboard/index.html", "permanent": false },
    { "source": "/library", "destination": "/frontend/pages/library/index.html", "permanent": false },
    { "source": "/pdf-study", "destination": "/frontend/pages/pdf-study/index.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    }
  ]
}
